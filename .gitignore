# Python cache / virtual environments
__pycache__/
*.py[cod]
*.pyo
.Python
.venv/
venv/
env/

# Tool outputs
output.mp4
*.tmp.mp4
*_clips/
output_clips/
capcut_video.mp4
joined_without_subtitles.mp4

# Large generated media
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.m4v
*.wav
*.mp3

# Keep bundled FFmpeg executables if this folder is used for portability.
!bin/
!bin/ffmpeg.exe
!bin/ffprobe.exe
!bin/ffplay.exe

# Keep local CapCut builder bundle for portable copies.
!vendor/
!vendor/auto_capcut_pro/
!vendor/auto_capcut_pro/python/
!vendor/auto_capcut_pro/capcut-mate/
!vendor/auto_capcut_pro/**

# Temporary/build folders
tmp/
temp/
*.tmp
*.bak
*.log

# Local response/debug files
acp_response.json

# OS/editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# PowerShell / installer scratch files
tools/ffmpeg/

# Always keep the portable CapCut builder bundle complete.
!vendor/
!vendor/**
