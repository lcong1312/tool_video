# CapCut Mate API Configurations

# Draft download URL - change to your own host if needed
DRAFT_URL=http://localhost:30000/openapi/capcut-mate/v1/get_draft

# Base URL for file downloads
DOWNLOAD_URL=http://localhost:30000/

# Draft save path for the International CapCut version
DRAFT_SAVE_PATH=C:/Users/CHINH_SERVER/AppData/Local/CapCut/User Data/Projects/com.lveditor.draft

# Optional: Tip URL
TIP_URL=https://docs.jcaigc.cn/

# Optional: COS configurations if you use cloud rendering
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET_NAME=
# COS_REGION=

# API Key Validation (set to false if you don't need point/key system)
ENABLE_APIKEY=false

# File download size limit (bytes), default 200MB
DOWNLOAD_FILE_SIZE_LIMIT=209715200

# Pexels API Key
PEXELS_API_KEY=6KdBASSeuri9m48ZP0gvrcZfmRcDJdWUJzrrHHermlKCUVGX4hESsmia
